# MySQL 8: sustituye usuario, contraseña y nombre de la base antes de usar.
DATABASE_URL="mysql://ayala_app:CAMBIAR_PASSWORD@localhost:3306/clinica_veterinaria_ayala"

# API
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=
JWT_TTL_SECONDS=900

# Solo se usan al ejecutar el seed para crear el primer administrador.
SEED_ADMIN_EMAIL=admin@clinica-ayala.local
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Administrador

# Frontend
VITE_API_URL=http://localhost:4000/api/v1
